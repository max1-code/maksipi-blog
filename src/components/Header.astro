---
interface Props {
  lang: string;
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;

const labels: Record<string, { home: string; about: string }> = {
  es: { home: 'Inicio', about: 'Sobre mí' },
  en: { home: 'Home', about: 'About' },
  ua: { home: 'Головна', about: 'Про мене' },
  ru: { home: 'Главная', about: 'Обо мне' },
};

const t = labels[lang] || labels.es;

// Smart language links: try to keep the same page type
function getLangHref(targetLang: string) {
  if (currentPath.includes('/about')) {
    return `/${targetLang}/about`;
  }
  if (currentPath.includes('/post/')) {
    // For posts we fall back to home of that language (translation may not exist)
    return `/${targetLang}/`;
  }
  return `/${targetLang}/`;
}
---

<header class="sticky top-0 z-50 border-b border-slate-800/60 bg-surface/85 backdrop-blur-xl">
  <div class="max-w-5xl mx-auto px-4 h-14 sm:h-16 flex items-center justify-between">
    <a
      href={`/${lang}/`}
      class="font-bold text-lg tracking-tight text-ink hover:text-accent transition-colors"
    >
      Maksipi
    </a>

    <nav class="flex items-center gap-0.5 sm:gap-1">
      <a href={`/${lang}/`} class="btn btn-ghost text-sm hidden sm:inline-flex">
        {t.home}
      </a>
      <a href={`/${lang}/about`} class="btn btn-ghost text-sm">
        {t.about}
      </a>

      <div class="ml-2 sm:ml-3 flex items-center gap-0.5 border-l border-slate-800 pl-2 sm:pl-3">
        {(['es', 'en', 'ua', 'ru'] as const).map((l) => (
          <a
            href={getLangHref(l)}
            class:list={[
              'text-[11px] sm:text-xs font-semibold min-w-[36px] min-h-[36px] sm:min-w-touch sm:min-h-touch flex items-center justify-center rounded-md transition-colors',
              l === lang
                ? 'text-accent bg-accent/10'
                : 'text-ink-muted hover:text-ink hover:bg-slate-800/50',
            ]}
            aria-current={l === lang ? 'page' : undefined}
            title={l.toUpperCase()}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>
