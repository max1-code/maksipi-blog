---
interface Props {
  hype: string;
  reality: string;
  hypeLabel?: string;
  realityLabel?: string;
}

const {
  hype,
  reality,
  hypeLabel = 'EL TITULAR',
  realityLabel = 'LA REALIDAD OPERATIVA',
} = Astro.props;
---

<div class="flex flex-col md:flex-row gap-4 my-10">
  <!-- El Hype -->
  <div class="flex-1 rounded-xl border border-slate-800 bg-slate-900/40 p-5">
    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3">
      {hypeLabel}
    </p>
    <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
      {hype}
    </p>
  </div>

  <!-- La Realidad -->
  <div class="flex-1 rounded-xl border border-slate-800 border-l-4 border-l-amber-500 bg-amber-500/5 p-5">
    <p class="text-[10px] font-bold uppercase tracking-widest text-amber-500/90 mb-3">
      {realityLabel}
    </p>
    <p class="text-sm sm:text-base text-ink leading-relaxed">
      {reality}
    </p>
  </div>
</div>
