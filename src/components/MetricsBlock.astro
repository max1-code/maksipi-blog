---
// Updated MetricsBlock that uses the new MetricCard system
import MetricCard from './MetricCard.astro';

interface Props {
  metrics: {
    cost?: string;
    bottleneck?: string;
    realUtility?: string;
  };
  lang: string;
}

const { metrics, lang } = Astro.props;

const labels: Record<string, { cost: string; bottleneck: string; utility: string }> = {
  es: { cost: 'Coste real', bottleneck: 'Cuello de botella', utility: 'Utilidad real' },
  en: { cost: 'Real cost', bottleneck: 'Bottleneck', utility: 'Real utility' },
  ua: { cost: 'Реальна вартість', bottleneck: 'Вузьке місце', utility: 'Реальна користь' },
  ru: { cost: 'Реальная стоимость', bottleneck: 'Узкое место', utility: 'Реальная польза' },
};

const t = labels[lang] || labels.es;

const items = [
  metrics.cost && {
    label: t.cost,
    value: metrics.cost,
    variant: 'bottleneck' as const,
  },
  metrics.bottleneck && {
    label: t.bottleneck,
    value: metrics.bottleneck,
    variant: 'bottleneck' as const,
  },
  metrics.realUtility && {
    label: t.utility,
    value: metrics.realUtility,
    variant: 'utility' as const,
  },
].filter(Boolean) as { label: string; value: string; variant: 'tech' | 'bottleneck' | 'utility' }[];
---

{items.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
    {items.map((item) => (
      <MetricCard
        label={item.label}
        value={item.value}
        variant={item.variant}
      />
    ))}
  </div>
)}
