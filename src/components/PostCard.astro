---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  href: string;
  lang: string;
  featured?: boolean;
}

const { title, description, pubDate, category, href, lang, featured = false } = Astro.props;

const categoryLabels: Record<string, Record<string, string>> = {
  es: {
    herramientas: 'Herramientas',
    modelos: 'Modelos',
    infraestructura: 'Infraestructura',
    negocio: 'Negocio',
  },
  en: {
    herramientas: 'Tools',
    modelos: 'Models',
    infraestructura: 'Infrastructure',
    negocio: 'Business',
  },
  ua: {
    herramientas: 'Інструменти',
    modelos: 'Моделі',
    infraestructura: 'Інфраструктура',
    negocio: 'Бізнес',
  },
  ru: {
    herramientas: 'Инструменты',
    modelos: 'Модели',
    infraestructura: 'Инфраструктура',
    negocio: 'Бизнес',
  },
};

const catLabel = categoryLabels[lang]?.[category] || category;

const dateLocale =
  lang === 'es' ? 'es-ES' : lang === 'en' ? 'en-US' : lang === 'ua' ? 'uk-UA' : 'ru-RU';
---

<a
  href={href}
  class:list={[
    'block card card-hover p-5 sm:p-6 group',
    featured && 'sm:col-span-2 border-accent/20',
  ]}
>
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <span class="tag">{catLabel}</span>
    {featured && (
      <span class="tag tag-active text-[10px] uppercase tracking-wider">
        {lang === 'es' ? 'Destacado' : 'Featured'}
      </span>
    )}
    <time
      class="text-xs text-ink-muted/80 ml-auto tabular-nums"
      datetime={pubDate.toISOString()}
    >
      {pubDate.toLocaleDateString(dateLocale, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      })}
    </time>
  </div>

  <h2
    class:list={[
      'font-semibold text-ink group-hover:text-accent transition-colors leading-snug',
      featured ? 'text-xl sm:text-2xl' : 'text-lg sm:text-xl',
    ]}
  >
    {title}
  </h2>

  <p class="mt-2.5 text-sm text-ink-muted leading-relaxed line-clamp-2">
    {description}
  </p>
</a>
