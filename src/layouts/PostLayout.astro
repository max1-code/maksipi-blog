---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import MetricsBlock from '../components/MetricsBlock.astro';
import Postura from '../components/Postura.astro';

interface Props {
  title: string;
  description: string;
  lang: string;
  pubDate: Date;
  category: string;
  metrics?: {
    cost?: string;
    bottleneck?: string;
    realUtility?: string;
  };
  conclusion: string;
}

const { title, description, lang, pubDate, category, metrics, conclusion } = Astro.props;

const categoryLabels: Record<string, Record<string, string>> = {
  es: {
    herramientas: 'Herramientas',
    modelos: 'Modelos',
    infraestructura: 'Infraestructura',
    negocio: 'Negocio',
  },
  en: {
    herramientas: 'Tools',
    modelos: 'Models',
    infraestructura: 'Infrastructure',
    negocio: 'Business',
  },
  ua: {
    herramientas: 'Інструменти',
    modelos: 'Моделі',
    infraestructura: 'Інфраструктура',
    negocio: 'Бізнес',
  },
  ru: {
    herramientas: 'Инструменты',
    modelos: 'Модели',
    infraestructura: 'Инфраструктура',
    negocio: 'Бизнес',
  },
};

const catLabel = categoryLabels[lang]?.[category] || category;
const dateLocale =
  lang === 'es' ? 'es-ES' : lang === 'en' ? 'en-US' : lang === 'ua' ? 'uk-UA' : 'ru-RU';
---

<BaseLayout title={title} description={description} lang={lang}>
  <ReadingProgress />

  <article class="max-w-3xl mx-auto px-4 py-10 sm:py-14">
    <header class="mb-8 sm:mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="tag tag-active">{catLabel}</span>
        <time datetime={pubDate.toISOString()} class="text-sm text-ink-muted tabular-nums">
          {pubDate.toLocaleDateString(dateLocale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-lg text-ink-muted leading-relaxed">
        {description}
      </p>
    </header>

    {metrics && <MetricsBlock metrics={metrics} lang={lang} />}

    <div class="prose-custom">
      <slot />
    </div>

    <Postura text={conclusion} lang={lang} />
  </article>
</BaseLayout>
